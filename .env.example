# Скопируйте этот файл в .env и вставьте свой ключ.
OPENAI_API_KEY=
# Модель для генерации, проверки и помощника.
OPENAI_MODEL=gpt-6-luna
# Необязательно: сколько модель «думает» при проверке ответов — none | low | medium | high | xhigh | max.
# Пусто — настройка модели по умолчанию. В приложении это можно поменять на странице настроек.
OPENAI_REASONING_EFFORT=
API_PORT=3001
# Необязательно: где хранить словарь, сохранённые предложения, историю и уже выданные предложения. По умолчанию — папка data.
DATA_DIR=
